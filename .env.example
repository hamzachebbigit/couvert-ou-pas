# Fournisseur principal : Gemini (clé gratuite sur Google AI Studio).
GEMINI_API_KEY=
# Deuxième clé optionnelle (autre projet Google) : double le quota journalier gratuit.
GEMINI_API_KEY_2=
# Identifiants de modèles, épinglés après un appel à la liste des modèles de la clé.
GEMINI_MODEL_VERDICT=
GEMINI_MODEL_CHEAP=
GEMINI_MODEL_EMBED=
# Fournisseur de repli optionnel exposant un point d'entrée chat/completions (URL de base, clé, modèle).
SECONDARY_BASE_URL=
SECONDARY_API_KEY=
SECONDARY_MODEL=
# Plafond quotidien d'appels au modèle hors cache.
DAILY_CAP=60
# Plafond par adresse et par minute sur /api/analyse.
PER_IP_PER_MINUTE=6
# Validation du jeton Cloudflare Access (vide = désactivée, usage local).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PORT=7860
# Emplacement du cache SQLite des verdicts (laisser vide pour data/cache.db).
CACHE_DB_PATH=
