# Clé du fournisseur de modèles (plateforme OpenAI).
OPENAI_API_KEY=
# Identifiants de modèles, épinglés après un appel à la liste des modèles de la clé (scripts/pick_models.py).
OPENAI_MODEL_VERDICT=
OPENAI_MODEL_CHEAP=
OPENAI_MODEL_EMBED=
# Appels par minute et par modèle.
OPENAI_RPM=60
# Plafond quotidien d'appels au modèle hors cache.
DAILY_CAP=60
# Plafond par adresse et par minute sur /api/analyse.
PER_IP_PER_MINUTE=6
# Validation du jeton Cloudflare Access (vide = désactivée, usage local).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
PORT=7860
# Emplacement du cache SQLite des verdicts (laisser vide pour data/cache.db).
CACHE_DB_PATH=
